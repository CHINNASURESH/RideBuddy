<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/rendertheme" version="1" map-background="#1A1A1A">
    <rule e="way" k="highway" v="motorway|trunk|primary|primary_link|trunk_link|motorway_link">
        <!-- Dark Basemaps (Night Mode) -->
        <!-- Highways: Dark Grey with neon yellow or orange glow -->
        <line stroke="#FFA500" stroke-width="4" />
        <line stroke="#383838" stroke-width="2" />
    </rule>
    <rule e="way" k="highway" v="secondary|tertiary|unclassified|residential|secondary_link|tertiary_link">
        <!-- Main Roads: Medium Grey -->
        <line stroke="#505050" stroke-width="2.5" />
    </rule>
    <rule e="way" k="highway" v="service|track|path|footway|cycleway|pedestrian|steps|living_street">
        <!-- Minor Roads: Very Dark Grey -->
        <line stroke="#262626" stroke-width="1.5" />
    </rule>
</rendertheme>
